# AttendAI configuration — copy to .env and adjust.
# Placeholders only; never commit a real .env (it is gitignored).

# SQLite database file (created + seeded by `node mock-portal/db/seed.js`).
# Relative paths resolve against the repository root.
DB_PATH=./data/attendai.db

# Mock portal
PORTAL_PORT=3000
PORTAL_URL=http://localhost:3000

# MCP server identity: who the AI agent acts as. Role checks are enforced
# server-side inside the tools, no matter what the model says or asks for.
#   teacher:anil.kumar   -> agent can mark attendance for anil.kumar's classes
#   student:1DS22CD001   -> agent can only read that student's attendance
# Leave empty for a read-only session (mark_attendance will be refused).
ATTENDAI_USER=

# Alternate write path for mark_attendance: Playwright visibly drives the
# mock portal UI instead of writing to SQLite directly.
USE_BROWSER_AUTOMATION=false

# Credentials the browser-automation path uses to log into the MOCK portal.
# These are fake demo accounts created by seed.js — never real ones.
PORTAL_TEACHER_USERNAME=anil.kumar
PORTAL_TEACHER_PASSWORD=teacher123

# Show the Playwright browser window during browser-automation demos.
HEADED=false
